<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Work interval (minutes)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <NumberPicker
            android:id="@+id/settingsWorkPicker"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rest duration (seconds)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <NumberPicker
            android:id="@+id/settingsRestPicker"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOCUS MODE"
            android:letterSpacing="0.06"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"/>

        <Switch
            android:id="@+id/focusModeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Focus Mode"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily focus goal (minutes)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

        <NumberPicker
            android:id="@+id/focusGoalPicker"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Long break after 4 sessions (minutes)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

        <NumberPicker
            android:id="@+id/longBreakPicker"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"/>

        <Switch
            android:id="@+id/blockYoutubeShortsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block YouTube Shorts"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/enableShortsBlockerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Shorts Blocker"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/blockedAppsSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No apps selected"
            android:textColor="#B8C1D1"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/selectBlockedAppsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Apps to Block during Focus"
            android:layout_marginBottom="14dp"/>

        <Switch
            android:id="@+id/keepOverlayPositionSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remember overlay position"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/preset2020Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restore 20–20 default"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/resetStatsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Timer &amp; Statistics"/>
    </LinearLayout>
</ScrollView>

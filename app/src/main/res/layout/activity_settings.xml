<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Work interval (minutes)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

        <NumberPicker
            android:id="@+id/settingsWorkPicker"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rest duration (seconds)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

        <NumberPicker
            android:id="@+id/settingsRestPicker"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"/>

        <Switch
            android:id="@+id/keepOverlayPositionSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remember overlay position"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/preset2020Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restore 20–20 default"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/resetStatsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Timer & Statistics"/>
    </LinearLayout>
</ScrollView>

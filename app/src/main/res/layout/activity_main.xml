<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="👁 20-20-20 Eye Care"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Ready"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="monospace"
            android:text="20:00"
            android:textColor="#22C55E"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sessionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Breaks completed: 0"
            android:textColor="#D1D5DB"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Work (minutes)"
                android:textColor="#D1D5DB" />

            <EditText
                android:id="@+id/workInput"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#9CA3AF"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Break (seconds)"
                android:textColor="#D1D5DB" />

            <EditText
                android:id="@+id/breakInput"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#9CA3AF"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/defaultsButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Use defaults (20 / 20)"
            android:textColor="#22C55E" />

        <Button
            android:id="@+id/startPauseButton"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#22C55E"
            android:text="Start"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#374151"
            android:text="Reset"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>

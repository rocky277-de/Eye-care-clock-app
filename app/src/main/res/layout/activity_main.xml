<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁 20-20-20 EYE CARE"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminder paused"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp"
            android:background="#111827"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT EYE BREAK"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/countdownText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00"
                android:textColor="#22C55E"
                android:textSize="52sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/sessionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breaks completed: 0"
                android:textColor="#D1D5DB"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TODAY"
            android:textColor="#D1D5DB"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:background="#111827"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#111827"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOCUS MODE"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/focusModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Block selected distractions while focusing"
                android:textColor="#D1D5DB"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/focusStatsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FOCUS TODAY"
                android:textColor="#D1D5DB"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:paddingTop="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7-DAY FOCUS HISTORY"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/focusHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#111827"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIMER SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#111827"
            android:padding="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Work interval (min)"
                android:textColor="#D1D5DB"
                android:textSize="14sp" />

            <NumberPicker
                android:id="@+id/workMinutesPicker"
                android:layout_width="100dp"
                android:layout_height="90dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#111827"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rest duration (sec)"
                android:textColor="#D1D5DB"
                android:textSize="14sp" />

            <NumberPicker
                android:id="@+id/restSecondsPicker"
                android:layout_width="100dp"
                android:layout_height="90dp" />
        </LinearLayout>

        <Button
            android:id="@+id/startPauseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start"
            android:backgroundTint="#22C55E"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="7dp" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:backgroundTint="#374151"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:backgroundTint="#7F1D1D"
            android:textColor="#FFFFFF"
            android:layout_marginTop="7dp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />
    </LinearLayout>
</ScrollView>
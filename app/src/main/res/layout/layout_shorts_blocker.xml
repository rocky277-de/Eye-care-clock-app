<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#111827">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚫  Shorts Blocked"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/shortsBlockerMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="YouTube Shorts is blocked"
        android:textColor="#D1D5DB"
        android:textSize="17sp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:layout_marginBottom="28dp"/>

    <Button
        android:id="@+id/leaveShortsButton"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Go Back"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/closeBlockerButton"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Close"
        android:backgroundTint="#374151"/>
</LinearLayout>
